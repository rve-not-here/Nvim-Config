{
  "troubleshooting note": {
    "prefix": "troubleshooting",
    "body": [
      "---",
      "type: troubleshooting",
      "tags:",
      "  - ${1:<tag>}",
      "---",
      "",
      "# ${3:<title (error message)>}",
      "",
      "## Stack Trace",
      "",
      "```",
      "${2:<stack trace>}",
      "```",
      "",
      "## Symptoms",
      "",
      "## Fix",
      "",
      "## Further Read"
    ],
    "description": "Troubleshooting knowledge note"
  },
  "recipe note": {
    "prefix": "recipe",
    "body": [
      "---",
      "type: recipe",
      "tags:",
      "  - ${1:<tag>}",
      "---",
      "",
      "# ${2:<title>}",
      "",
      "## How it works",
      "",
      "${3:<mental model, invariants, key mechanism>}",
      "",
      "## Example",
      "",
      "```",
      "${4:<minimal working example>}",
      "```",
      ""
    ],
    "description": "Recipe knowledge note"
  },
  "concept note": {
    "prefix": "concept",
    "body": [
      "---",
      "type: concept",
      "tags:",
      "  - ${1:<tag>}",
      "---",
      "",
      "# ${2:<title>}",
      "",
      "## Definition",
      "${3:<1-3 sentences, jargon-free if possible>}",
      "",
      "## Why it Matters",
      "${4:<the problem it solves / motivation>}",
      "",
      "## How it works",
      "${5:<mental model, invariants, key mechanism>}",
      "",
      "## Example",
      "<minimal working example>",
      "",
      "## Anti-patterns",
      "",
      "## Further Read"
    ],
    "description": "Concept knowledge note"
  },
  "runbook note": {
    "prefix": "runbook",
    "body": [
      "---",
      "type: runbook",
      "tags:",
      "  - ${1:<tag>}",
      "---",
      "",
      "# ${2:<title>}",
      "",
      "## Goal",
      "",
      "## Steps",
      "",
      "## Verification",
      "",
      "## Further Read"
    ],
    "description": "Runbook knowledge note"
  }
}
